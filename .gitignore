# Frontend build artifacts
frontend/dist/
frontend/node_modules/

# Generated bindings (auto-generated by Wails)
frontend/bindings/

# SoundFont files (downloaded during build, not committed)
signal/app/public/soundfonts/*.sf2

# Built signal files copied to frontend
frontend/public/signal/

# Wails task checksums
.task/

# Native audio assets and preserved local web workspace
soundfonts/*.sf2
.legacy-frontend/
