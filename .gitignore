# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Mac crap
.DS_Store

.kilo
.vscode

*.ini
*.log

# Reference code (old AHK implementation)
.ref

# Node
node_modules/
frontend/app/public/soundfonts/*.sf2
frontend/packages/*/dist/

# Go build output
bin/

# Signal fork build artifacts
signal/node_modules/
signal/app/dist/
signal/app/node_modules/
signal/packages/*/dist/
